<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/edit_text_bg_task">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvQueueRowSender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="bKash"
            android:textColor="@color/black1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQueueRowSim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM 1"
            android:textColor="@color/txtGrayTask"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvQueueRowBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="You received Tk 500 from 017... TrxID 9K8L7..."
        android:textColor="@color/secondText"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvQueueRowReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reason: Unmatched pattern / Error"
            android:textColor="@color/redMa"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQueueRowTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:30 PM"
            android:textColor="@color/txtGrayTask"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>